NODE_ENV=development
HOST=0.0.0.0
PORT=3333
# Exemplo local: postgresql://extraok:SENHA@127.0.0.1:5432/extraok?schema=public
DATABASE_URL=
# Use 1 com Prisma Dev local, que aceita uma conexao por vez.
DATABASE_POOL_MAX=10
WEB_ORIGIN=http://localhost:5173
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=
# Ative depois de aplicar as migrations e verificar o remetente no Resend.
PASSWORD_RESET_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Gere 32 bytes aleatorios; use um segredo diferente de PASSWORD_PEPPER.
PASSWORD_RESET_OTP_SECRET=
# Ative o Pix depois das migrations e da homologação. Veja STRIPE.md.
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
# Chaves exclusivas da API. Prefira rk_test_... restrita; sk_test_... tambem e aceita.
# O segredo whsec_... pertence ao webhook do mesmo ambiente.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_LIVE_MODE=false
# ID UUID da conta proprietária isenta de cobrança. Vazio mantém as regras normais.
BILLING_OWNER_USER_ID=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
# Cadastre esta URL no painel de Webhooks; Orders não usa notification_url.
MERCADOPAGO_WEBHOOK_URL=
# false em testes; true com a conta e as credenciais reais em produção.
MERCADOPAGO_LIVE_MODE=false
SESSION_TTL_DAYS=30
SESSION_IDLE_HOURS=12
APPROVAL_LINK_TTL_DAYS=30
TERMS_VERSION=2026-09-01
LOG_LEVEL=info
TRUST_PROXY=false
