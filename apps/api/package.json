{
  "name": "@extraok/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "billing:check": "tsx src/scripts/check-billing.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio --config prisma.studio.config.ts --port 5555"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
