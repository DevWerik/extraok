# Ambiente do Docker Compose. Copie para .env e preencha os campos obrigatorios.
# Campos vazios fazem o Compose falhar de proposito, antes de iniciar o deploy.
POSTGRES_DB=extraok
POSTGRES_USER=extraok
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Dentro do Compose o host do banco deve ser "postgres". Codifique caracteres
# reservados da senha na URL ou use uma senha URL-safe.
DATABASE_URL=
# Origem publica exata, sem caminho nem barra final. Local: http://localhost:8080
WEB_ORIGIN=
WEB_PORT=8080
# Gere pelo menos 32 bytes aleatorios e nao reutilize a senha do banco.
PASSWORD_PEPPER=
# Recuperacao de senha via API HTTPS do Resend (somente backend).
PASSWORD_RESET_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_OTP_SECRET=
# Planos via Pix. Consulte apps/api/BILLING.md antes de ativar.
BILLING_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_LIVE_MODE=false
SESSION_TTL_DAYS=30
SESSION_IDLE_HOURS=12
APPROVAL_LINK_TTL_DAYS=30
TERMS_VERSION=2026-09-01
LOG_LEVEL=info
TRUST_PROXY=true
